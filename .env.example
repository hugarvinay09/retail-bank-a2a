ENVIRONMENT=local
LOG_LEVEL=INFO
OTEL_EXPORTER_OTLP_ENDPOINT=
AUTH_DISABLED=true
ENABLE_KNOWLEDGE=true
ENABLE_ACCOUNT_READS=true
ENABLE_PAYMENT_PROPOSALS=true
ENABLE_PAYMENT_EXECUTION=true
JWT_ISSUER=https://cognito-idp.ap-south-1.amazonaws.com/REPLACE_ME
JWT_AUDIENCE=retail-bank-a2a
JWT_JWKS_URL=https://cognito-idp.ap-south-1.amazonaws.com/REPLACE_ME/.well-known/jwks.json
OPENAI_API_KEY=replace-me
OPENAI_MODEL=gpt-5.6-terra
OPENAI_REASONING_EFFORT=low
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
COHERE_API_KEY=replace-me
COHERE_RERANK_MODEL=rerank-v3.5
PINECONE_API_KEY=replace-me
PINECONE_INDEX=retail-bank-knowledge
PINECONE_NAMESPACE=approved-policies
DATABASE_URL=postgresql+asyncpg://bank:bank@localhost:5432/bank_agents
REDIS_URL=redis://localhost:6379/0
BANK_API_BASE_URL=http://localhost:8090
BANK_API_TOKEN=local-bank-sandbox-token
S3_DOCUMENT_BUCKET=retail-bank-a2a-documents
AWS_REGION=ap-south-1
SAFETY_HMAC_KEY=replace-with-32-or-more-random-characters
MAX_INPUT_CHARS=8000
REQUEST_TIMEOUT_SECONDS=25
PAYMENT_APPROVAL_TTL_SECONDS=600
MAX_PAYMENT_AMOUNT=100000
ALLOWED_CURRENCIES=INR,USD,GBP,EUR
